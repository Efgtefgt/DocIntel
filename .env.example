# Copy to .env and adjust. All settings are optional; defaults suit an 8 GB RAM, CPU-only laptop.

# Full path to tesseract.exe (leave empty to search PATH and C:\Program Files\Tesseract-OCR)
DOCINTEL_TESSERACT_CMD=
# Folder containing *.traineddata files (leave empty to use Tesseract's own tessdata folder)
DOCINTEL_TESSDATA_DIR=
# Default OCR language(s), joined with + (must be installed), e.g. eng+hin
DOCINTEL_DEFAULT_LANGUAGES=eng
DOCINTEL_DEFAULT_ENGINE=tesseract
# Words scored below this (engine-specific 0-100 scale) are highlighted for review
DOCINTEL_LOW_CONFIDENCE_THRESHOLD=60

# Input limits
DOCINTEL_MAX_FILE_SIZE_MB=25
DOCINTEL_MAX_PDF_PAGES=200
DOCINTEL_MAX_IMAGE_PIXELS=40000000
DOCINTEL_MAX_IMAGE_DIMENSION=12000

# Performance (1 worker = sequential processing, recommended on 8 GB RAM)
DOCINTEL_PDF_RENDER_DPI=200
DOCINTEL_OCR_TIMEOUT_SECONDS=60
DOCINTEL_DOCUMENT_TIMEOUT_SECONDS=900
DOCINTEL_MAX_WORKERS=1
# Smart preprocessing: max OCR runs per page (extra runs happen only when a result looks weak)
DOCINTEL_MAX_OCR_ATTEMPTS=3

# Files (temp dir empty = system temp folder)
DOCINTEL_TEMP_DIR=
DOCINTEL_EXPORT_DIR=outputs
DOCINTEL_LOG_LEVEL=INFO
# Batch processing: folder for queued batches, their copied inputs and results
# (empty = %LOCALAPPDATA%\DocIntelatches). Delete batches from the Batch page when done.
DOCINTEL_BATCH_DIR=
DOCINTEL_BATCH_MAX_FILES=500
# Before each file, wait (up to a minute) while free memory is below this many MB
DOCINTEL_BATCH_MIN_FREE_MEMORY_MB=600
DOCINTEL_LOG_TO_FILE=true

# User interface: initial theme (light or dark); can be switched in the app sidebar
DOCINTEL_UI_THEME=light

# Local AI (Ollama): intentionally disabled. Nothing is downloaded and no language model is ever called.

# Optional features
DOCINTEL_ENABLE_PADDLE=false
DOCINTEL_API_MAX_REQUEST_MB=25
